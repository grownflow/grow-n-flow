# Copy to .env and fill in. Never commit .env.

# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_strong_random_secret

# Optional: if set, new accounts must enter this code to register.
# Useful while the game is on a public URL but not open to everyone.
# SIGNUP_SECRET=

# Set to 1 when running behind a TLS-terminating reverse proxy (see HOSTING.md).
# TRUST_PROXY=1
